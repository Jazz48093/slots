{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/sites", "destination": "/sites.html" },
    { "source": "/hub", "destination": "/sites.html" },
    { "source": "/vercel", "destination": "/sites.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
